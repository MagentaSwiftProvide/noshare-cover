# noshare-cover для Arch: собирается против установленного Hyprland.
# После обновления hyprland пакет надо пересобрать: плагин, собранный под
# другие заголовки, откажется грузиться (проверка хеша), а не уронит композитор.
pkgname=hyprland-noshare-cover-git
pkgver=0.2.0
pkgrel=1
pkgdesc="Hyprland plugin: image or video instead of the no_screen_share black box"
arch=('x86_64' 'aarch64')
url="https://github.com/gitscout-bot/noshare-cover"
license=('BSD-3-Clause')
depends=('hyprland' 'gcc-libs' 'glibc')
makedepends=('cargo' 'nasm' 'git' 'pkgconf' 'clang' 'libva' 'mesa')
optdepends=(
    'openh264: H.264 на CPU'
    'libvpx: VP8/VP9 на CPU'
    'libva: декод на GPU через VA-API (Intel, AMD)'
    'nvidia-utils: декод на GPU через NVDEC (NVIDIA)'
)
provides=('hyprland-noshare-cover')
conflicts=('hyprland-noshare-cover')
# NSC_REPO — для сборки из локального клона: NSC_REPO=/path/to/repo makepkg
source=("noshare-cover::git+${NSC_REPO:-https://github.com/gitscout-bot/noshare-cover.git}")
sha256sums=('SKIP')
options=('!lto' '!debug')

pkgver() {
    cd noshare-cover
    printf '0.2.0.r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd noshare-cover
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd noshare-cover
    export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
    make
}

check() {
    cd noshare-cover
    export RUSTUP_TOOLCHAIN=stable
    cargo test --release --locked --offline
}

package() {
    cd noshare-cover
    install -Dm755 libnoshare-cover.so "$pkgdir/usr/lib/hyprland/plugins/libnoshare-cover.so"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 include/noshare_cover_api.h "$pkgdir/usr/include/noshare-cover/noshare_cover_api.h"
}
